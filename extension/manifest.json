{
  "manifest_version": 3,
  "name": "Unfarm: clean your X feed",
  "short_name": "Unfarm",
  "version": "0.1.0",
  "description": "Hides AI slop and copy-paste engagement farms on X, with receipts. Free, open source, no API key. Nothing leaves your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://aluz123.github.io/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/engine.js", "src/settings.js", "data/*.json"],
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"]
    }
  ]
}
